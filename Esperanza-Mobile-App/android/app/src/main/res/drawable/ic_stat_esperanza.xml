<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon for push notifications: the Esperanza seal as a
     silhouette - its outer ring with the two dots, the inner circle with its
     three panels, and the tuna. Android draws small icons from their shape
     alone (white on transparent, tinted), so the seal's colours and lettering
     cannot show at this size; this is the shape that still reads as the seal
     (owner, 2026-10-16). The full-colour seal is the in-app banner's. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,0.75A11.25,11.25 0,1 1,11.99,0.75ZM12,2.35A9.65,9.65 0,1 0,12.01,2.35Z" />
    <!-- The two dots on the lettered band -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.01,14.21A0.7,0.7 0,1 1,4.0,14.21ZM19.99,14.21A0.7,0.7 0,1 1,19.98,14.21Z" />
    <!-- Inner circle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,4.6A7.4,7.4 0,1 1,11.99,4.6ZM12,5.7A6.3,6.3 0,1 0,12.01,5.7Z" />
    <!-- The panels: across the middle, and down the top half -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.75,11.55H18.25V12.4H5.75ZM11.6,5.75H12.4V11.6H11.6Z" />
    <!-- The tuna -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.4,14.9C15.3,13.6 12.6,13.3 10.4,14.3L8.4,13.2L9.1,14.9L8.4,16.6L10.4,15.5C12.6,16.5 15.3,16.2 16.4,14.9Z" />
</vector>
