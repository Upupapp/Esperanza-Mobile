<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) replaced the old windowBackground splash with the
         system SplashScreen API, which cannot be turned off. Left to itself it
         derives an icon from the launcher icon and draws it on the window.

         Owner, 2026-10-12: no still seal before the app opens; go straight to
         the animated one. So the icon is a blank drawable and the window is
         the same navy the app's own splash (SplashScreen) opens on: the
         system's screen reads as the first frame of the animation.

         Only LaunchTheme is overridden here; NormalTheme is inherited from
         values/styles.xml, and Flutter swaps to it once the engine is up. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/esperanza_navy_900</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
