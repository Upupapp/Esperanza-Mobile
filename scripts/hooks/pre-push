#!/bin/sh
# Pre-push gate for Esperanza-Mobile.
#
# There is no CI on this repository, so the local gate is the only gate, and
# /Users/user/CLAUDE.md's deploy protocol requires it before every push. This
# makes that mechanical instead of remembered.
#
# Runs the FULL suite, not the fast tier (scripts/check.sh). tool/fast_test.dart
# says so itself: it is a per-save subset and explicitly not the gate.
#
# Skipped only for code that already passed it: scripts/check.sh records the
# fingerprint (a git tree hash) of the exact files it checked when it passes.
# A push whose every commit holds exactly such code runs nothing new; any other
# push (a merge of someone else's work included) runs the full gate.
# ESPERANZA_FORCE_GATE=1 git push always runs it. This is not a bypass: the
# same content already passed this same gate.
#
# Plain sh on purpose: GitHub Desktop pushes with its own git, which ships sh
# but not bash.
#
# To bypass: git push --no-verify. That is a protocol violation, not a
# shortcut — if you need it, say so in the push report.

# git passes the refs being pushed on stdin; nothing below may read it again,
# or the push deadlocks.
pushed=$(cat)
exec < /dev/null

record="$(git rev-parse --git-path esperanza-mobile-verified-trees 2>/dev/null)"
if [ -z "${ESPERANZA_FORCE_GATE:-}" ] && [ -n "$pushed" ] && [ -f "$record" ]; then
  skip=1
  when=""
  for sha in $(printf '%s\n' "$pushed" | awk '{print $2}'); do
    case "$sha" in *[!0]*) ;; *) continue ;; esac   # all zeros: a deleted branch
    tree=$(git rev-parse --verify --quiet "$sha^{tree}") || { skip=0; break; }
    hit=$(grep "^$tree " "$record" | tail -1) || { skip=0; break; }
    [ -n "$hit" ] || { skip=0; break; }
    when=${hit#* }
  done
  if [ "$skip" = 1 ] && [ -n "$when" ]; then
    echo "pre-push: this exact code passed the full gate at $when; not running it again."
    echo "          (ESPERANZA_FORCE_GATE=1 git push runs it anyway.)"
    exit 0
  fi
fi

exec sh "$(git rev-parse --show-toplevel)/scripts/check.sh"
